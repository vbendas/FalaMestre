%%{init: {'theme': 'base', 'themeVariables': {'fontSize': '13px'}}}%%
flowchart TD
    subgraph client["CLIENT LAYER"]
        PWA["Next.js 16 + React 19<br/>mobile-first UI<br/>Tailwind CSS 4 + Framer Motion"]
    end

    subgraph api["API ROUTES (Next.js)"]
        CONV["/api/conversation<br/>Chat + intent classification"]
        MATCH["/api/match, /api/match/stream,<br/>/api/match/decide<br/>Simulation + turn decisions"]
        SQUAD["/api/squad/*<br/>Formation, training, migrate"]
        ECON["/api/transfer, /api/stadium,<br/>/api/facilities, /api/staff, /api/youth<br/>Club management"]
        META["/api/predictions, /api/investment,<br/>/api/tournaments, /api/daily-reward<br/>In-game meta systems"]
        ONBOARD["/api/onboarding/create-team"]
        AUTH["/api/auth/[...nextauth]<br/>next-auth, JWT sessions"]
    end

    subgraph cron["CRON JOBS"]
        CRON_YIELD["/api/cron/daily-yield<br/>/api/cron/expire-yields<br/>In-game investment yields"]
    end

    subgraph lib["CORE LIBRARIES"]
        AI["ai-service.ts<br/>LLM integration + mock mode"]
        ENGINE["game-engine.ts<br/>Match simulation"]
        DECIDE["decision-engine.ts +<br/>match-segment-engine.ts<br/>Turn-based match decisions"]
        COMMENT["commentary.ts<br/>Match narration"]
    end

    subgraph db["DATA LAYER"]
        PG[("Neon PostgreSQL<br/>Drizzle ORM")]
    end

    subgraph external["EXTERNAL SERVICES"]
        OPENROUTER["OpenRouter<br/>LLM API (optional)"]
        GOOGLE["Google OAuth<br/>(optional sign-in)"]
    end

    PWA --> CONV
    PWA --> MATCH
    PWA --> SQUAD
    PWA --> ECON
    PWA --> META
    PWA --> ONBOARD
    PWA --> AUTH
    CONV --> AI
    MATCH --> ENGINE
    MATCH --> DECIDE
    ENGINE --> COMMENT
    CONV --> PG
    MATCH --> PG
    SQUAD --> PG
    ECON --> PG
    META --> PG
    ONBOARD --> PG
    CRON_YIELD --> PG
    AI --> OPENROUTER
    AUTH --> GOOGLE

    classDef client fill:#4ade80,stroke:#166534,color:#000,font-weight:bold
    classDef api fill:#60a5fa,stroke:#1e40af,color:#000,font-weight:bold
    classDef cron fill:#a78bfa,stroke:#5b21b6,color:#000,font-weight:bold
    classDef lib fill:#ec4899,stroke:#9d174d,color:#000,font-weight:bold
    classDef db fill:#f59e0b,stroke:#92400e,color:#000,font-weight:bold
    classDef external fill:#ef4444,stroke:#991b1b,color:#fff,font-weight:bold

    class PWA client
    class CONV,MATCH,SQUAD,ECON,META,ONBOARD,AUTH api
    class CRON_YIELD cron
    class AI,ENGINE,DECIDE,COMMENT lib
    class PG db
    class OPENROUTER,GOOGLE external
