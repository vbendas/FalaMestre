# Fala Mestre! environment variables
# Copy to app/.env.local and fill in what you need. Nothing here is required
# to play locally except AUTH_DISABLED=true; see README.md for details.

# Postgres connection string (Neon serverless driver) for a hosted database.
# Leave empty to run on the embedded Postgres (PGlite) under app/.data/pglite,
# which needs no setup and keeps saves across restarts.
# Example: postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Directory for the embedded database when DATABASE_URL is empty. Relative
# paths resolve from app/. Default: .data/pglite. One server process per
# directory; give a second dev server its own.
PGLITE_DATA_DIR=

# Folder of committed SQL migrations the embedded database applies on startup.
# Relative paths resolve from app/. Default: drizzle. Only change for tests.
DRIZZLE_MIGRATIONS_DIR=

# OpenRouter API key for LLM responses. Without it the assistant runs in mock mode.
OPENROUTER_API_KEY=

# OpenRouter model id used for chat and insights (default: google/gemini-2.0-flash-001).
AI_MODEL=google/gemini-2.0-flash-001

# Set to "true" to force the canned mock assistant even when an API key is set.
USE_MOCK_AI=false

# Google OAuth credentials for next-auth sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL of the app; read by next-auth itself (not via app code).
NEXTAUTH_URL=http://localhost:3001

# Secret used by next-auth to sign JWT sessions (e.g. `openssl rand -base64 32`).
NEXTAUTH_SECRET=

# Set to "true" to skip sign-in in local development. Never enable in production.
AUTH_DISABLED=false

# Bearer secret required by the /api/cron/* routes and accepted by /api/predictions/settle.
CRON_SECRET=

# Bearer secret that also authorizes /api/predictions/settle (manual settlement).
ADMIN_SECRET=

# Lowest log level the server writes: debug, info, warn or error. Default: info.
# Every line is one JSON object; see "Logs" in README.md. Set to debug to also
# see the per-match formation mapping and memory monitor lines.
LOG_LEVEL=info
